{
  "schema_version": 1,
  "product": "pbui-chat-demo",
  "types": {
    "product": {
      "doc": "a sellable coin SKU in the shop inventory",
      "idHint": "products.id (a number)",
      "tone": "var(--pbui-tone-product)",
      "verbs": [
        "inspect",
        "watch",
        "compareWith",
        "askAgent",
        "reorder"
      ],
      "example": "[[product:2049|1oz American Gold Eagle 2024]]"
    },
    "category": {
      "doc": "a product category",
      "idHint": "categories.id",
      "tone": "var(--pbui-tone-category)",
      "verbs": [
        "inspect",
        "askAgent",
        "addFilter"
      ],
      "example": "[[category:7|American Gold Eagles]]"
    },
    "metal": {
      "doc": "a precious metal (gold, silver, platinum, palladium)",
      "idHint": "metal slug",
      "tone": "var(--pbui-tone-metal)",
      "verbs": [
        "inspect",
        "addFilter",
        "askAgent"
      ],
      "example": "[[metal:gold|gold]]"
    },
    "order": {
      "doc": "a customer order",
      "idHint": "orders.id",
      "tone": "var(--pbui-tone-order)",
      "verbs": [
        "inspect",
        "watch",
        "askAgent"
      ],
      "example": "[[order:88213|order 88213]]"
    },
    "tile": {
      "doc": "one pane of the user's screen, showing one application",
      "idHint": "placementId, from workbench_describe",
      "tone": "var(--pbui-selected)",
      "verbs": [
        "tile.split",
        "tile.close",
        "tile.replace",
        "tile.link",
        "view.setTitle",
        "view.goTo",
        "askAgent"
      ],
      "example": "[[tile:n-7|inventory]]"
    },
    "workspace": {
      "doc": "a named tree of tiles; the user sees one at a time",
      "idHint": "workspaceId, from workbench_describe",
      "tone": "var(--pbui-tone-neutral)",
      "verbs": [
        "workspace.select",
        "workspace.rename",
        "workspace.delete",
        "workspace.clone",
        "askAgent"
      ],
      "example": "[[workspace:ws-2|Gold desk]]"
    },
    "app": {
      "doc": "an application that can be placed in a tile",
      "idHint": "appId, from workbench_describe",
      "tone": "var(--pbui-pane-alt)",
      "verbs": [
        "app.place",
        "askAgent"
      ],
      "example": "[[app:inventory|inventory]]"
    },
    "program": {
      "doc": "a small program written in the sandbox dialect, running in a tile",
      "idHint": "programId, from sandbox_describe or the tool that created it",
      "tone": "var(--pbui-tone-widget)",
      "verbs": [
        "program.open",
        "inspect",
        "program.pin",
        "program.remove",
        "askAgent"
      ],
      "example": "[[program:prg-7|Days of cover]]"
    },
    "action": {
      "doc": "a generated action in the menu of some presentation types",
      "idHint": "actionId, from sandbox_describe",
      "tone": "var(--pbui-tone-neutral)",
      "verbs": [
        "inspect",
        "action.remove",
        "askAgent"
      ],
      "example": "[[action:act-3|Days of cover]]"
    },
    "conversation": {
      "doc": "one conversation with an agent; the id is its chat session id",
      "idHint": "conversationId, from conversation_list",
      "tone": "var(--pbui-pane-alt)",
      "verbs": [
        "conversation.open",
        "conversation.select",
        "conversation.rename",
        "conversation.send",
        "inspect",
        "askAgent"
      ],
      "example": "[[conversation:3f0a…|reorder desk]]"
    },
    "field": {
      "doc": "a column of a table the agent produced",
      "idHint": "<tableId>.<column>",
      "tone": "var(--pbui-tone-field)",
      "verbs": [
        "inspect",
        "addFilter",
        "sortBy",
        "askAgent"
      ],
      "example": "[[field:t3.qty|qty]]"
    },
    "row": {
      "doc": "one row of a table the agent produced",
      "idHint": "<tableId>#<rowIndex>",
      "tone": "var(--pbui-tone-row)",
      "verbs": [
        "inspect",
        "watch",
        "askAgent"
      ]
    },
    "source": {
      "doc": "a piece of evidence the agent cited",
      "idHint": "evidence id E<n>",
      "tone": "var(--pbui-tone-source)",
      "verbs": [
        "inspect",
        "askAgent"
      ],
      "example": "[[source:E2|pricing policy §3]]"
    },
    "widget": {
      "doc": "a widget the agent published",
      "idHint": "widget id returned by pbui_widget",
      "tone": "var(--pbui-tone-widget)",
      "verbs": [
        "inspect",
        "openInTile",
        "askAgent"
      ]
    },
    "tool": {
      "doc": "a tool call the agent made",
      "idHint": "tool call id",
      "tone": "var(--pbui-tone-tool)",
      "verbs": [
        "inspect",
        "rerunTool",
        "askAgent"
      ]
    },
    "proposal": {
      "doc": "a consequential action awaiting a human decision",
      "idHint": "proposal id",
      "tone": "var(--pbui-tone-proposal)",
      "verbs": [
        "inspect",
        "resolveProposal",
        "askAgent"
      ]
    },
    "traceEntry": {
      "doc": "one performed verb in the session trace",
      "idHint": "sequence number",
      "tone": "var(--pbui-tone-trace)",
      "verbs": [
        "inspect",
        "askAgent"
      ]
    },
    "unresolved": {
      "doc": "a mention the server could not resolve",
      "idHint": "the original type and id",
      "tone": "var(--pbui-tone-neutral)",
      "verbs": [
        "askAgent"
      ]
    }
  },
  "verbs": {
    "inspect": {
      "doc": "show the object in the inspector",
      "fields": {
        "ref": "ref"
      }
    },
    "watch": {
      "doc": "pin the object to the watchlist",
      "fields": {
        "ref": "ref"
      }
    },
    "compareWith": {
      "doc": "compare the object with another of the same type (enters accept mode)",
      "fields": {
        "left": "ref",
        "right?": "ref"
      }
    },
    "askAgent": {
      "doc": "send the agent a question about the objects",
      "fields": {
        "template": "string",
        "refs": "refs"
      }
    },
    "addFilter": {
      "doc": "filter a table by a field",
      "fields": {
        "tableId": "string",
        "field": "string",
        "op": "string",
        "value": "string"
      }
    },
    "sortBy": {
      "doc": "sort a table by a field",
      "fields": {
        "tableId": "string",
        "field": "string",
        "dir": "string"
      }
    },
    "openInTile": {
      "doc": "open the widget in its own tile",
      "fields": {
        "widgetId": "string"
      }
    },
    "rerunTool": {
      "doc": "ask the agent to run the tool again",
      "fields": {
        "toolCallId": "string",
        "args?": "object"
      }
    },
    "resolveProposal": {
      "doc": "approve or reject a proposal",
      "fields": {
        "id": "string",
        "decision": "string"
      },
      "danger": true
    },
    "reorder": {
      "doc": "draft a reorder for the product",
      "fields": {
        "productId": "string"
      },
      "danger": true
    },
    "tile.split": {
      "doc": "open a new pane beside a tile",
      "fields": {
        "placementId": "string",
        "direction": "string",
        "appId?": "string"
      }
    },
    "tile.close": {
      "doc": "close a tile",
      "fields": {
        "placementId": "string"
      },
      "danger": true
    },
    "tile.swap": {
      "doc": "exchange what two tiles show",
      "fields": {
        "a": "string",
        "b": "string"
      }
    },
    "tile.dock": {
      "doc": "move a tile to an edge of another",
      "fields": {
        "source": "string",
        "target": "string",
        "zone": "string"
      }
    },
    "tile.activate": {
      "doc": "make a tile the keyboard target",
      "fields": {
        "placementId": "string"
      }
    },
    "tile.replace": {
      "doc": "show a different application in a tile",
      "fields": {
        "placementId": "string",
        "appId": "string",
        "documents?": "object"
      },
      "danger": true
    },
    "tile.link": {
      "doc": "show an existing view in a tile too",
      "fields": {
        "placementId": "string",
        "viewId": "string"
      }
    },
    "split.resize": {
      "doc": "move a divider",
      "fields": {
        "splitId": "string",
        "ratio": "number"
      }
    },
    "app.place": {
      "doc": "open an application beside the active tile",
      "fields": {
        "appId": "string",
        "from?": "string"
      }
    },
    "view.setTitle": {
      "doc": "name a tile, or clear its name",
      "fields": {
        "viewId": "string",
        "title": "string"
      }
    },
    "view.open": {
      "doc": "open an application on specific documents in a new tile",
      "fields": {
        "appId": "string",
        "documents": "object",
        "near?": "string",
        "title?": "string"
      }
    },
    "view.rebind": {
      "doc": "point a tile at different documents",
      "fields": {
        "viewId": "string",
        "documents": "object"
      }
    },
    "view.goTo": {
      "doc": "go to the tile showing a view",
      "fields": {
        "viewId": "string"
      }
    },
    "workspace.select": {
      "doc": "show a different workspace",
      "fields": {
        "workspaceId": "string"
      }
    },
    "workspace.create": {
      "doc": "create a workspace of tiles",
      "fields": {
        "name": "string",
        "spec?": "object",
        "workspaceId?": "string",
        "select?": "boolean"
      }
    },
    "workspace.rename": {
      "doc": "rename a workspace",
      "fields": {
        "workspaceId": "string",
        "name": "string"
      }
    },
    "workspace.delete": {
      "doc": "delete a workspace and its tiles",
      "fields": {
        "workspaceId": "string"
      },
      "danger": true
    },
    "workspace.clone": {
      "doc": "duplicate a workspace",
      "fields": {
        "workspaceId": "string",
        "name?": "string",
        "newWorkspaceId?": "string",
        "select?": "boolean"
      }
    },
    "launcher.open": {
      "doc": "open the launcher",
      "fields": {
        "placementId?": "string"
      }
    },
    "launcher.close": {
      "doc": "close the launcher",
      "fields": {}
    },
    "program.open": {
      "doc": "open a stored program in a tile, bound to the given documents",
      "fields": {
        "programId": "string",
        "documents?": "object",
        "near?": "string",
        "title?": "string"
      }
    },
    "program.remove": {
      "doc": "remove a program from the library and close its tiles",
      "fields": {
        "programId": "string"
      },
      "danger": true
    },
    "program.pin": {
      "doc": "pin a program so the agent cannot change or remove it unasked",
      "fields": {
        "programId": "string",
        "pinned": "boolean"
      }
    },
    "action.run": {
      "doc": "perform a generated action on an object",
      "fields": {
        "actionId": "string",
        "ref": "ref"
      }
    },
    "action.remove": {
      "doc": "remove a generated action from every menu",
      "fields": {
        "actionId": "string"
      },
      "danger": true
    },
    "conversation.new": {
      "doc": "start another conversation and open it in a tile",
      "fields": {
        "title?": "string",
        "prompt?": "string",
        "near?": "string"
      }
    },
    "conversation.open": {
      "doc": "open a conversation in a tile beside another",
      "fields": {
        "conversationId": "string",
        "near?": "string"
      }
    },
    "conversation.select": {
      "doc": "make a conversation the active one",
      "fields": {
        "conversationId": "string"
      }
    },
    "conversation.rename": {
      "doc": "give a conversation a name",
      "fields": {
        "conversationId": "string",
        "title": "string"
      }
    },
    "conversation.send": {
      "doc": "send a message to another conversation",
      "fields": {
        "conversationId": "string",
        "template": "string",
        "refs?": "refs"
      }
    }
  },
  "widget": {
    "schema_version": 1,
    "kinds": [
      "text",
      "refs",
      "meter",
      "sparkline",
      "segmented",
      "stat",
      "callout",
      "table",
      "log",
      "form",
      "widget"
    ],
    "layouts": [
      "stack",
      "row",
      "grid"
    ]
  },
  "conversions": [
    {
      "from": "row",
      "to": "product"
    }
  ],
  "sandbox": {
    "schema_version": 1,
    "kinds": [
      "panel",
      "row",
      "column",
      "text",
      "badge",
      "button",
      "input",
      "select",
      "table",
      "meter",
      "sparkline",
      "callout",
      "ref"
    ],
    "intents": [
      "state/merge",
      "state/replace",
      "verb"
    ]
  }
}
