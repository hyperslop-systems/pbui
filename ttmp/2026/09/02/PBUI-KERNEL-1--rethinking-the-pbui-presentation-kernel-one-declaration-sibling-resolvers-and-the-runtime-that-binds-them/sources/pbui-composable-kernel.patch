@@ -1,99 +1,272 @@
+import {
+  bindingOf,
+  programOf,
+  type BindingExpression,
+  type BindingProgram,
+  type BindingSource,
+} from "./expression";
 import type { LinkDeps, LinkSnapshot } from "./snapshot";
-import { terms, type Binding, type Diagnostic, type SerializableReference } from "./terms";
+import {
+  terms,
+  type Binding,
