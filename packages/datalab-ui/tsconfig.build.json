{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/main.tsx", "src/**/*.stories.tsx"]
}
