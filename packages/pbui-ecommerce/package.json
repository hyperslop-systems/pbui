{
  "name": "@hyperslop-systems/pbui-ecommerce",
  "version": "0.1.0",
  "description": "The gold-coin shop as a PBUI workbench: an in-memory host over orders, customers, products and sales, tiles that declare ports, and plots over @hyperslop-systems/plot \u2014 the first consumer of tile linking (PBUI-LINK-1)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/pbui-ecommerce.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hyperslop-systems/pbui.git",
    "directory": "packages/pbui-ecommerce"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6012 --no-open",
    "e2e": "node e2e/scenes.mjs",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@hyperslop-systems/pbui": "workspace:^",
    "@hyperslop-systems/pbui-workbench": "workspace:^",
    "@hyperslop-systems/plot": "0.3.1",
    "@hyperslop-systems/workbench-core": "workspace:^",
    "@hyperslop-systems/workbench-protocol": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^26.1.0",
    "playwright": "1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.1"
}
