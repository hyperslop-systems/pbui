{
  "format": "pbui.workbench",
  "schemaVersion": 1,
  "id": "workbench-production",
  "name": "Production analysis",
  "workspaces": [
    {
      "id": "workspace-overview",
      "name": "Overview",
      "tree": {
        "id": "placement-overview",
        "leaf": {
          "viewId": "view-chart"
        }
      }
    },
    {
      "id": "workspace-detail",
      "name": "Detail",
      "tree": {
        "id": "placement-detail",
        "leaf": {
          "viewId": "view-chart"
        }
      }
    }
  ],
  "views": {
    "view-chart": {
      "id": "view-chart",
      "appId": "chart",
      "title": "Mass and yield",
      "documents": {
        "primary": "document-chart"
      }
    }
  },
  "viewOrder": [
    "view-chart"
  ],
  "documents": {
    "document-chart": {
      "id": "document-chart",
      "format": "datadrop.gog.document",
      "schemaVersion": 2,
      "body": {
        "name": "Mass and yield",
        "sources": {
          "source:root": {
            "id": "source:root",
            "source": {
              "kind": "stream",
              "drop": "production",
              "stream": "batches"
            },
            "scope": {
              "kind": "bounded-window",
              "limit": 2000,
              "strategy": "latest"
            }
          }
        },
        "transforms": {},
        "views": {
          "view:root": {
            "id": "view:root",
            "relation": {
              "kind": "source",
              "sourceId": "source:root"
            },
            "mark": "point",
            "encodings": {},
            "yScale": "linear",
            "analysis": {
              "kind": "identity"
            },
            "facetScales": "fixed"
          }
        },
        "rootView": "view:root",
        "parameters": {}
      }
    }
  }
}
